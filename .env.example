# Llave de la API de Claude (Anthropic). Nunca subir el valor real a git.
ANTHROPIC_API_KEY=

# Modelo a usar para generar el informe. Cambiar aquí cuando Anthropic
# libere un modelo nuevo, sin tocar código.
ANTHROPIC_MODEL=claude-sonnet-5

# Puerto del servidor API/Express (no el de Vite, que usa 5173 en dev).
PORT=3001
